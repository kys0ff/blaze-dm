<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder><pattern>%d{HH:mm:ss} %-5level %logger{25} - %msg%n</pattern></encoder>
    </appender>
    <logger name="bt.net" level="DEBUG"/>
    <logger name="bt.peer" level="DEBUG"/>
    <logger name="bt.tracker" level="DEBUG"/>
    <logger name="bt.dht" level="DEBUG"/>
    <root level="INFO"><appender-ref ref="STDOUT"/></root>
</configuration>